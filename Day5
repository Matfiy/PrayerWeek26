        }

        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to bottom, rgba(18, 28, 22, 0.4), rgba(13, 17, 15, 1));
            z-index: 1;
        }

        .logo,
        .hero-content {
            position: relative;
            z-index: 2;
        }

        .logo {
            position: absolute;
            top: 30px;
            left: 20px;
            font-family: var(--font-condensed);
            color: var(--accent-yellow);
            font-size: 1.2rem;
            line-height: 1;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-align: left;
        }

        .subtitle-top {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: -5px;
            font-weight: 400;
            opacity: 0.9;
        }

        .main-title {
            font-family: var(--font-serif);
            font-size: 22vw;
            line-height: 0.85;
            color: var(--accent-yellow);
            margin: 10px 0;
            text-transform: uppercase;
            font-weight: 900;
            text-shadow: 0px 4px 10px rgba(0, 0, 0, 0.5);
        }

        .subtitle-bottom {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 15px;
