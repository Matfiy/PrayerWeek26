</head>

<body>

    <section class="hero">
        <div class="overlay"></div>

        <div class="logo">
            PRAYER<br>WEEK
        </div>

        <div class="hero-content">
            <p class="subtitle-top">МОЛИТВА ПРО КРАЇНУ</p>
            <h1 class="main-title">DAY<br>FIVE</h1>
            <p class="subtitle-bottom">ВДЯЧНІСТЬ, ВЛАДА ТА НАЦІЯ</p>

            <div class="lang-controls">
                <button class="btn-lang" onclick="switchTab('ua')">УКРАЇНСЬКА</button>
                <button class="btn-lang" onclick="switchTab('en')">ENGLISH</button>
