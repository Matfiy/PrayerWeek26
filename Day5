            font-size: 0.9em;
            display: block;
            margin-top: 5px;
        }

        .verse-block {
            border-left: 3px solid var(--accent-yellow);
            padding-left: 15px;
            margin-bottom: 35px;
        }

        .scripture {
            font-family: var(--font-serif);
            font-style: italic;
            font-size: 1.15rem;
            line-height: 1.5;
