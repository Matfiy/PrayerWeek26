        }

        body {
            margin: 0;
            padding: 0;
            font-family: var(--font-sans);
            background-color: var(--bg-dark);
            color: var(--text-white);
            -webkit-font-smoothing: antialiased;
        }

        /* ---hero section--- */
        .hero {
            position: relative;
            height: 100vh;
            width: 100%;
            /* Forest Background - Day 5 */
            background-image: url('https://tithely-media-prod.s3.us-west-1.wasabisys.com/1094070/Day-5-Background.png');
            background-size: cover;
            background-position: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
